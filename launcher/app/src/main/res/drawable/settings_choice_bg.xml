<?xml version="1.0" encoding="utf-8"?>
<!-- A row or chip: translucent glass; focus is a brighter slab with a white rim, like the launcher's tile highlight. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#47FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
