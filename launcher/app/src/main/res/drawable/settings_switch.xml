<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:width="52dp" android:height="30dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF7CD4FF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:width="24dp" android:height="24dp" android:gravity="right|center_vertical" android:right="3dp">
                <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="52dp" android:height="30dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3DFFFFFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:width="24dp" android:height="24dp" android:gravity="left|center_vertical" android:left="3dp">
                <shape android:shape="oval"><solid android:color="#FFE9EEF5" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
